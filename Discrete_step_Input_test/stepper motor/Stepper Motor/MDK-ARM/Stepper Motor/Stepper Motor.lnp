--cpu Cortex-M3
"stepper motor\startup_stm32f103xb.o"
"stepper motor\main.o"
"stepper motor\stm32f1xx_it.o"
"stepper motor\stm32f1xx_hal_msp.o"
"stepper motor\stm32f1xx_hal_gpio_ex.o"
"stepper motor\stm32f1xx_hal_tim.o"
"stepper motor\stm32f1xx_hal_tim_ex.o"
"stepper motor\stm32f1xx_hal.o"
"stepper motor\stm32f1xx_hal_rcc.o"
"stepper motor\stm32f1xx_hal_rcc_ex.o"
"stepper motor\stm32f1xx_hal_gpio.o"
"stepper motor\stm32f1xx_hal_dma.o"
"stepper motor\stm32f1xx_hal_cortex.o"
"stepper motor\stm32f1xx_hal_pwr.o"
"stepper motor\stm32f1xx_hal_flash.o"
"stepper motor\stm32f1xx_hal_flash_ex.o"
"stepper motor\stm32f1xx_hal_exti.o"
"stepper motor\stm32f1xx_hal_uart.o"
"stepper motor\system_stm32f1xx.o"
--strict --scatter "Stepper Motor\Stepper Motor.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Stepper Motor.map" -o "Stepper Motor\Stepper Motor.axf"